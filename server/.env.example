# MongoDB connection string for this environment.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Generate a unique, high-entropy secret; never commit the real value.
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=7d
PORT=3001
# Comma-separated public frontend origins, without a trailing slash.
CORS_ORIGIN=https://your-project.vercel.app
# Public HTTPS URL used for uploaded file links.
BASE_URL=https://api.example.com
